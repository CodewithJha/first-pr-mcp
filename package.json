{
  "name": "first-pr-mcp",
  "version": "1.0.0",
  "description": "MCP server that helps an agent turn someone into a first-time open source contributor.",
  "type": "module",
  "author": "Priyanshu Jha (https://github.com/CodewithJha)",
  "license": "MIT",
  "homepage": "https://github.com/CodewithJha/first-pr-mcp",
  "engines": {
    "node": ">=22.22.2"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "mcp-use",
    "open-source",
    "good-first-issue"
  ],
  "scripts": {
    "dev": "mcp-use dev",
    "build": "mcp-use build",
    "start": "mcp-use start",
    "typecheck": "mcp-use typecheck",
