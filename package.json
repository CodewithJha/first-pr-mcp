    "deploy:manufact": "mcp-use deploy"
  },
  "dependencies": {
    "mcp-use": "^2.12.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mcp-use/client": "^2.4.6",
    "@types/node": "^22.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.165.0"
  }
}
